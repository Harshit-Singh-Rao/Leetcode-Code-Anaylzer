{
  "manifest_version": 3,
  "name": "AI Coder Analyzer",
  "version": "1.0",
  "description": "Analyze code for logic, complexity, and optimizations.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Analyze Code"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "*://*.leetcode.com/*"
  ]
}
